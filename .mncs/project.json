{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-atlas",
  "revision": 6,
  "manifest_location": "in-repository",
  "authority": {
    "note": "Atlas owns non-normative family orientation and ownership indexing only; Commons owns canonical architecture/convergence facts, and Atlas does not create normative conformance, pressure status, or sibling-project authority."
  },
  "organization": {
    "layout": "mncs.repository-layout/1",
    "surfaces": [
      {"path": "registry/", "class": "generated", "authority": "mncs-atlas", "note": "Orientation projection; not canonical Commons architecture.", "classification": {"authority": "none", "lifecycle": "generated", "boundary_kind": "none", "semantic_role": "generated"}},
      {"path": "site/", "class": "canonical", "authority": "mncs-atlas", "note": "Human/family orientation source.", "classification": {"authority": "canonical", "lifecycle": "active", "boundary_kind": "none", "semantic_role": "canonical-semantic"}},
      {"path": "scripts/", "class": "host-boundary", "note": "Static-site, filesystem, and registry projection adapters.", "classification": {"authority": "none", "lifecycle": "active", "boundary_kind": "filesystem", "semantic_role": "platform-adapter"}}
    ]
  },
  "contracts": {
    "provides": [
      {
        "contract": "family-map",
        "version": "0.4",
        "kind": "orientation-surface",
        "stability": "experimental",
        "fingerprint_sources": ["site/atlas.json", "docs/PROJECTS.md"]
      },
      {
        "contract": "family-registry",
        "version": "1",
        "kind": "compiled-orientation-graph",
        "stability": "experimental",
        "fingerprint_sources": ["registry/project-catalog.json", "registry/capability-claims.json", "registry/decisions.json", "registry/manifest-snapshot.json"]
      },
      {
        "contract": "context-capsule",
        "version": "1",
        "kind": "orientation-capsule",
        "stability": "experimental",
        "fingerprint_sources": ["registry/__main__.py", "docs/REGISTRY.md"]
      }
    ],
    "consumes": [
      {
        "contract": "mncs.repository-manifest-format",
        "envelope": {"op": "any"},
        "required": false,
        "notes": "Atlas consumes repository-owned manifests as descriptive graph inputs."
      },
      {
        "contract": "mncs-control.journal-context",
        "envelope": {"op": "any"},
        "required": false
      },
      {
        "contract": "mncs-commons.family-architecture",
        "envelope": {"op": "any"},
        "required": false,
        "notes": "Commons remains canonical for architecture/convergence facts; Atlas consumes only bounded orientation inputs."
      }
    ],
    "tests": [
      {
        "test": "registry-tests",
        "covers": ["family-registry", "context-capsule"],
        "obligation": "self",
        "command": {"argv": ["python", "-m", "unittest", "discover", "-s", "tests", "-t", "."]}
      },
      {
        "test": "registry-validation",
        "covers": ["family-registry"],
        "obligation": "family-integration",
        "command": {"argv": ["python", "-m", "registry", "validate"]}
      }
    ]
  }
}
