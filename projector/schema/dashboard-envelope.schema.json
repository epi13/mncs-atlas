{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mncs.dev/schemas/atlas-dashboard-envelope-1.schema.json",
  "title": "Atlas dashboard envelope",
  "description": "Deterministic dashboard envelope: projector identity plus observed semantic epoch outside the hash, projection payload inside.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "semantic_hash", "projection"],
  "properties": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projector", "projector_version"],
      "properties": {
        "projector": {"const": "mncs-atlas.projector"},
        "projector_version": {"type": "string", "minLength": 1},
        "source_epoch": {"type": "string", "minLength": 1},
        "observed_sources": {"type": "object"}
      }
    },
    "semantic_hash": {"type": "string", "pattern": "^sha256:"},
    "projection": {
      "type": "object",
      "required": ["schema_version", "semantic_hash", "sources", "freshness", "ecosystem", "relationships", "capabilities", "implementation", "pressures", "verification", "movement", "journal"],
      "properties": {
        "schema_version": {"const": "mncs-atlas.dashboard-projection/v1"},
        "semantic_hash": {"type": "string", "pattern": "^sha256:"},
        "sources": {"type": "array", "minItems": 1},
        "freshness": {
          "type": "object",
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["complete", "partial", "unavailable"]},
            "reason": {"type": "string"}
          }
        },
        "ecosystem": {"type": "object"}
      }
    }
  }
}
